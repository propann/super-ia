{
  "schema_version": 2,
  "policy": {
    "profile_storage": "docker_named_volume_local_only",
    "cookies": "never_export",
    "login": "interactive_once_per_provider",
    "automation": "human_first",
    "account_rotation": "forbidden",
    "network": "localhost_only"
  },
  "profiles": [
    {
      "id": "chatgpt",
      "label": "ChatGPT",
      "url": "https://chatgpt.com/",
      "remote_url": "https://127.0.0.1:3011/",
      "probe_url": "http://browser-chatgpt:3000/",
      "container_profile": "browser-chatgpt",
      "icon": "◎",
      "accent": "green",
      "description": "Chromium sur le Pi, profil persistant séparé.",
      "command": "make browser-up BROWSER_PROFILES=browser-chatgpt",
      "capabilities": ["chat", "files", "projects"]
    },
    {
      "id": "claude",
      "label": "Claude",
      "url": "https://claude.ai/",
      "remote_url": "https://127.0.0.1:3012/",
      "probe_url": "http://browser-claude:3000/",
      "container_profile": "browser-claude",
      "icon": "◌",
      "accent": "orange",
      "description": "Chromium sur le Pi, connexion humaine isolée.",
      "command": "make browser-up BROWSER_PROFILES=browser-claude",
      "capabilities": ["chat", "artifacts", "projects"]
    },
    {
      "id": "gemini",
      "label": "Gemini",
      "url": "https://gemini.google.com/",
      "remote_url": "https://127.0.0.1:3013/",
