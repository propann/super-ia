TZ=Europe/Paris
COMPOSE_PROJECT_NAME=super-ia

# Persistence
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=superia
POSTGRES_USER=superia
POSTGRES_PASSWORD=replace_with_a_long_alphanumeric_password

# Vector memory
QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_API_KEY=replace_with_a_long_random_key

# Automation
N8N_IMAGE=n8nio/n8n:latest
N8N_ENCRYPTION_KEY=replace_with_a_32_character_or_longer_key
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://127.0.0.1:5678/
N8N_SECURE_COOKIE=false

# Local command center
DASHBOARD_PORT=8080

# Multi-provider AI gateway
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_MASTER_KEY=replace_with_a_long_gateway_key
LITELLM_LOG_LEVEL=INFO

# Provider keys stay local and are never committed.
# ChatGPT web login is independent from the OpenAI API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Chromium desktops on the Pi. BROWSER_PASSWORD is generated by make init.
BROWSER_IMAGE=lscr.io/linuxserver/chromium:latest
BROWSER_PUID=1000
BROWSER_PGID=1000
BROWSER_USER=azoth
BROWSER_PASSWORD=replace_with_a_local_browser_password
BROWSER_WIDTH=1280
BROWSER_HEIGHT=800
BROWSER_CHATGPT_PORT=3011
BROWSER_CLAUDE_PORT=3012
BROWSER_GEMINI_PORT=3013
BROWSER_DEEPSEEK_PORT=3014
BROWSER_GROK_PORT=3015
BROWSER_MISTRAL_PORT=3016
BROWSER_SUNO_PORT=3017
